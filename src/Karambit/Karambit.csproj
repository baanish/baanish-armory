<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Baanish.Karambit</AssemblyName>
    <RootNamespace>Baanish.Karambit</RootNamespace>
    <Version>0.3.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">$(NUCLEAR_OPTION_DIR)</GameDir>
    <Managed>$(GameDir)/NuclearOption_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Mirage" HintPath="$(Managed)/Mirage.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TerrainPhysicsModule" HintPath="$(Managed)/UnityEngine.TerrainPhysicsModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Managed)/Assembly-CSharp.dll')" Text="Set NUCLEAR_OPTION_DIR or pass -p:GameDir to the installed Nuclear Option folder." />
    <Error Condition="!Exists('$(GameDir)/BepInEx/core/BepInEx.dll')" Text="BepInEx 5 must be installed in GameDir." />
  </Target>
</Project>
