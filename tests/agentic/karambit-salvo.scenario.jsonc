      }
    },
    {
      "act": {
        "fire": 5
      }
    },
    {
      "wait": {
        "path": "mods.dev.baanish.karambit.salvo-test.mission_time_s",
        "between": [
          45,
          50
        ]
      },
      "timeout": 50,
      "label": "measure at 45 s before the patrol boat can engage the incoming missiles"
    },
    {
      "check": {
        "custom": {
          "name": "CruiseSalvoObserved",
          "args": {
            "since": "salvo"
          }
        }
      },
      "within": 1,
      "label": "report original inbound survivors and actual launches before asserting success"
    },
    {
      "record": {
        "path": "truth.missiles.count"
      },
      "label": "uncapped final live missile count, including remaining Karambits"
    },
    {
      "record": {
        "path": "own.station.ammo"
      },
      "label": "ammunition remaining after the continuous trigger"
    },
    {
      "record": {
        "path": "mods.dev.baanish.karambit.salvo-test.mission_time_s"
      },
      "label": "native mission time of the survivor measurement"
    },
    {
      "screenshot": {
        "name": "karambit-salvo-result"
      }
    },
    {
      "require": {
        "custom": {
          "name": "CruiseSalvoDestroyed",
          "args": {
            "since": "salvo"
          }
        }
      },
      "label": "twenty distinct designated launches remove all twenty original AShM-300s before boat defense range"
