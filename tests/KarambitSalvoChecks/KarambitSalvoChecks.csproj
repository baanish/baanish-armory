<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>CA1416;MSB3277</NoWarn>
    <FrameworkDir Condition="'$(FrameworkDir)' == ''">E:/Development/NO-Agentic-Framework</FrameworkDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NoAgenticFramework.Runner" HintPath="$(FrameworkDir)/src/NoAgenticFramework.Runner/bin/Release/net8.0/NoAgenticFramework.Runner.dll" />
    <Compile Include="../agentic/karambit_salvo.cs" Link="karambit_salvo.cs" />
  </ItemGroup>
</Project>
